  "info": {
    "_postman_id": "c969f36e-6b89-43ee-95ab-25568d403d7c",
    "name": "Treasury Fiscal Data Exchange Rates Securities API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The U.S. Treasury Fiscal Data API provides free, open access to federal financial data including national debt, interest rates, exchange rates, and detailed fiscal operations data. No authentication or API key is required. The API uses RESTful principles, accepts GET requests, and returns JSON responses with standardized pagination, filtering, sorting, and field selection across 80+ endpoints covering all major Treasury financial reports.\n\nContact Support:\n Name: Bureau of the Fiscal Service\n Email: FiscalDataHelp@fiscal.treasury.gov",
      "type": "text/plain"
    }
  }
